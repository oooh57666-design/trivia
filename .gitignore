# Env files (DO NOT upload secrets)
.env
.env.local
.env.*.local

# MacOS junk
.DS_Store

# Windows junk
Thumbs.db

# Temp files
*.tmp
*.temp

# IDE/system files
.vscode/
.idea/
*.swp

# Firebase hosting previews
firebase-hosting-cache/
